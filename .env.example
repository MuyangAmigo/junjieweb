# Absolute path to your Obsidian vault (required for publish.sh)
VAULT_PATH=/path/to/your/obsidian/vault

# Azure Blob Storage (required for media upload scripts)
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=images

# Azure AI Foundry (required for vision-based image renaming scripts)
FOUNDRY_API_KEY=your-api-key-here
FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-5.4
